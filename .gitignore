# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Environment (secrets) — never commit; .env.example is the committed template
app/.env

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
app/build/
app/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
app/android/app/debug
app/android/app/profile
app/android/app/release

# Android release signing — NEVER commit. Contains store/key passwords.
app/android/key.properties
key.properties

# Keystores — private signing material. Keep local/offline backups only.
*.jks
*.keystore
credentials/

# Local reference media — not app source. Third-party sample wallpapers/videos
# and design screenshots/recordings; kept out of the public repository.
creative/
uiux/

# Local diagnostic artifacts (device logs, env backups, build outputs)
*.aab
*.apk
env.backup*
ad_device_verification*
