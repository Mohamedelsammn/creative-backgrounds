# API — public feed (no auth required; the bearer token is admin-only)
BASE_URL=https://creative-backgrounds.arabplus4tech.com/api/v1/public
API_KEY=
# Object-storage origin reported by GET /config as `cdnBaseUrl`. Asset URLs in
# API responses are already absolute, so this is informational.
IMAGE_BASE_URL=https://creative-backgrounds.arabplus4tech.com/storage

# Force update (Feature 1) — remote policy document, compared against the
# installed Android versionCode. Expected shape:
#   {"android":{"minimumSupportedBuild":47,"latestBuild":47,
#    "forceUpdate":true,"storeUrl":"https://play.google.com/...",
#    "updateMessage":{"en":"...","ar":"..."}}}
# LEAVE BLANK to disable the gate. Blank, unreachable, or malformed all
# resolve to fail-open (nobody is blocked) — never to a default minimum.
UPDATE_POLICY_URL=

# Network
TIMEOUT_CONNECT_MS=10000
TIMEOUT_RECEIVE_MS=30000

# Features
ENABLE_PREMIUM=true
ENABLE_DEPTH_WALLPAPERS=true
ENABLE_LIVE_CLOCK=true

# Development
DEBUG_MODE=false
LOGGING_ENABLED=false
# When true, ads stay on Google's test ad unit IDs even in a --release build
# (e.g. testing a release-candidate APK before the real Play Store submission).
# Real ad unit IDs otherwise activate automatically whenever the app is built
# with --release - see AppConfig.useRealAdUnits / lib/core/ads/ad_constants.dart.
FORCE_TEST_ADS=false
# When true, the app serves bundled fixture data instead of hitting BASE_URL.
# The fixtures are written in the real API shape and go through the same
# parsers, so this exercises production mapping offline.
# NOTE: the live catalog currently has no published wallpapers, so flipping
# this to false yields (correct) empty states until content is published.
MOCK_API=false
